{
    "name": "willow-lane-lemonade",
    "description": "A classic Windows lemonade stand management game.",
    "version": "0.2.0-alpha.13",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Gamez0/lemonade-tycoon.git"
    },
    "license": "MIT",
    "licenseUrl": "http://www.opensource.org/licenses/mit-license.php",
    "bugs": {
        "url": "https://github.com/Gamez0/lemonade-tycoon/issues"
    },
    "homepage": "https://github.com/Gamez0/lemonade-tycoon",
    "scripts": {
        "test": "tsc -p tsconfig.simulation.json && node --test tests/simulation.cjs tests/street-day.cjs tests/save.cjs tests/async-save.cjs tests/file-storage.cjs tests/locations.cjs tests/management.cjs tests/display-settings.cjs tests/close-checkpoint.cjs",
        "dev": "node log.js dev & vite --config vite/config.dev.mjs",
        "build": "node log.js build & vite build --config vite/config.prod.mjs",
        "dev-nolog": "vite --config vite/config.dev.mjs",
        "build-nolog": "vite build --config vite/config.prod.mjs",
        "lint": "eslint . --ext .js,.mjs,.cjs,.ts",
        "lint:fix": "eslint . --ext .js,.mjs,.cjs,.ts --fix",
        "typecheck": "tsc -p tsconfig.reboot.json",
        "lint:reboot": "eslint src/reboot.ts src/game --max-warnings 0",
        "test:browser": "playwright test",
        "desktop:run": "npm run build-nolog && electron .",
        "desktop:package:win": "npm run build:desktop && node scripts/package-win.cjs",
        "test:desktop": "node tests/desktop.cjs",
        "test:desktop:ui": "node tests/desktop-ui.cjs",
        "test:desktop:management": "node tests/desktop-management.cjs",
        "test:preview:engines": "node tests/preview-engines.cjs",
        "store:capture": "node scripts/store-capture.cjs",
        "audio:export": "node scripts/audio-export.cjs",
        "test:desktop:locations": "node tests/desktop-locations.cjs",
        "test:desktop:upgrade": "node scripts/m4-device-evidence.cjs",
        "test:desktop:dpi": "node scripts/desktop-dpi.cjs",
        "test:desktop:display": "node tests/desktop-display.cjs",
        "test:desktop:audio": "node tests/desktop-audio.cjs",
        "test:desktop:campaign": "node tests/desktop-campaign.cjs",
        "test:desktop:performance": "node scripts/desktop-performance.cjs",
        "test:desktop:long-save": "node tests/desktop-long-save.cjs",
        "build:desktop": "vite build --config vite/config.desktop.mjs && node scripts/audit-desktop.cjs desktop-dist",
        "test:release": "node --test tests/release.cjs",
        "release:manifest": "node scripts/release-manifest.cjs"
    },
    "devDependencies": {
        "@electron/packager": "^20.3.0",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.63.0",
        "@types/webfontloader": "^1.6.38",
        "electron": "^44.5.1",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.1",
        "eslint-plugin-prettier": "^5.2.3",
        "globals": "^16.0.0",
        "terser": "^5.51.2",
        "typescript": "^5.4.5",
        "typescript-eslint": "^8.71.1",
        "vite": "^6.4.4"
    },
    "dependencies": {
        "phaser": "^3.87.0",
        "webfontloader": "^1.6.28"
    },
    "main": "src/desktop/main.cjs"
}
